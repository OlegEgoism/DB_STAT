# Python cache files
__pycache__/

# Virtual environments
.venv/
venv/

# IDE / editor files
.idea/
.vscode/

# Environment variables / secrets
/.env

# SQLite database (including WAL-mode sidecar files)
db.sqlite3
db.sqlite3-shm
db.sqlite3-wal

# Django collected static files
staticfiles/

# User-uploaded media files
media/

# Django migrations (keep __init__.py)
**/migrations/*.py
!**/migrations/__init__.py
