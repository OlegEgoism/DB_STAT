SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
TIME_ZONE=Europe/Minsk
LANGUAGE_CODE=ru

# Set these only behind a TLS-terminating reverse proxy — enabling them
# without one breaks plain-http access entirely (redirect loop / rejected
# requests). See the comment above SECURE_SSL_REDIRECT in db/settings.py.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_PROXY_SSL_HEADER=False

DB_CONNECTION_ENCRYPTION_KEY=

# Таймауты запросов к целевым БД (миллисекунды). Защищают приложение от зависания,
# когда запрос ждёт блокировку или выполняется слишком долго. См. db/settings.py.
# DB_LOCK_TIMEOUT_MS=3000
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_BACKGROUND_LOCK_TIMEOUT_MS=30000
# DB_BACKGROUND_STATEMENT_TIMEOUT_MS=600000

# Бюджет соединений с целевой БД. Каждый воркер gunicorn держит свой пул: на каждое
# сохранённое подключение — до DB_CONNECTION_POOL_MAX_CONN соединений.
#   Итого на целевой БД ≈ GUNICORN_WORKERS × DB_CONNECTION_POOL_MAX_CONN × число сохранённых подключений в работе.
# Фоновые задачи (VACUUM/ANALYZE, PDF-отчёты) берут соединения из тех же пулов.
# Пример: 3 воркера × 10 соединений × 2 подключения = до 60 соединений на целевой БД.
# Проверьте, что это укладывается в max_connections целевой БД с запасом для остальных клиентов.
# Если пул исчерпан, приложение отвечает 503 «Превышен лимит соединений с целевой БД».
# Значение больше 20 вызывает предупреждение db_statistics.W003 в manage.py check.
# DB_CONNECTION_POOL_MIN_CONN=1
# DB_CONNECTION_POOL_MAX_CONN=10
# GUNICORN_WORKERS=3

# Initial Docker account. INITIAL_ADMIN_PASSWORD defaults to "admin" if left
# unset (not a generated one) — set it explicitly on any installation that
# isn't strictly local-only. These values are ignored once a user exists.
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=admin

SQLITE_NAME=db.sqlite3

# Настройки SQLite служебной базы приложения. SQLITE_SYNCHRONOUS: NORMAL (по умолчанию, быстрее:
# при внезапном отключении питания последние транзакции могут откатиться, файл не повреждается),
# FULL (каждая фиксация ждёт записи на диск), EXTRA. SQLITE_CACHE_KIB — размер кэша страниц в КиБ.
# SQLITE_SYNCHRONOUS=NORMAL
# SQLITE_CACHE_KIB=16384

STATIC_URL=static/

# Postgres host to substitute when a saved connection's host is "localhost"
# (see LOCALHOST_NAMES in db/settings.py) — from inside a container,
# "localhost" means the container itself, not the Docker host running it.
LOCALHOST_DB_HOST=127.0.0.1
