SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
TIME_ZONE=Europe/Minsk
LANGUAGE_CODE=ru

# Set these only behind a TLS-terminating reverse proxy — enabling them
# without one breaks plain-http access entirely (redirect loop / rejected
# requests). See the comment above SECURE_SSL_REDIRECT in db/settings.py.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_PROXY_SSL_HEADER=False

DB_CONNECTION_ENCRYPTION_KEY=

# Initial Docker account. INITIAL_ADMIN_PASSWORD defaults to "admin" if left
# unset (not a generated one) — set it explicitly on any installation that
# isn't strictly local-only. These values are ignored once a user exists.
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=admin

SQLITE_NAME=db.sqlite3

STATIC_URL=static/

# Postgres host to substitute when a saved connection's host is "localhost"
# (see LOCALHOST_NAMES in db/settings.py) — from inside a container,
# "localhost" means the container itself, not the Docker host running it.
LOCALHOST_DB_HOST=127.0.0.1
